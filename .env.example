# Ambiente da aplicação
NODE_ENV=development
APP_ENV=development

# Servidor
PORT=8080
FRONTEND_PORT=5173
BACKEND_PORT=8080

# Banco de dados
POSTGRES_DB=hotel_laranjeira
POSTGRES_USER=hotel_laranjeira
POSTGRES_PASSWORD=hotel_laranjeira_dev
POSTGRES_PORT=5432
DATABASE_URL="postgres://hotel_laranjeira:hotel_laranjeira_dev@localhost:5432/hotel_laranjeira?sslmode=disable"

# Autenticação
# Em produção, use um segredo longo e aleatório.
JWT_SECRET=hotel-laranjeira-development-secret-change-me
FRONTEND_ORIGIN=http://localhost:5173

# Administrador criado somente se o e-mail ainda não existir
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@hotel.com
INITIAL_ADMIN_PASSWORD=admin12345678
INITIAL_RECEPTION_NAME=Recepção
INITIAL_RECEPTION_EMAIL=recepcao@hotel.com
INITIAL_RECEPTION_PASSWORD=recepcao123456
